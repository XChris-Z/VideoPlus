{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Video Downloader",
  "version": "1.0.13",
  "identifier": "com.xchrisz.videodownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Universal Video Downloader",
        "width": 1150,
        "height": 950,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "bin/yt-dlp.exe",
      "bin/ffmpeg.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "XChris-Z",
    "shortDescription": "Descargador universal de videos usando yt-dlp.",
    "longDescription": "Aplicación ultrarrápida para descargar videos y audios de múltiples plataformas, desarrollada por XChris-Z.",
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/XChris-Z/VideoPlus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4RTczN0Q3RjQ2REFEMUQKUldRZHJXMzAxemZuYVBhNDk2ZlZRcGFTTEpZZSt4RmJFMjhMdTk1bzU4VGdzV3JpcEN1VXROTnUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}